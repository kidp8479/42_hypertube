# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real secrets.

POSTGRES_USER=hypertube
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hypertube

# Host-side ports docker-compose publishes to (127.0.0.1 only). Only the edge
# proxy is published (HYP-71): the backend and the frontend are reachable
# through it, not directly. Only override a port when something else on the
# host already holds it (e.g. a work stack on an internship machine); if you
# change HYPERTUBE_HTTPS_PORT, also update FRONTEND_ORIGIN and the two
# *_CALLBACK_URL below, and the redirect URIs registered at 42 and GitHub.
#
# HYPERTUBE_DB_PORT only matters if you use a personal, git-ignored
# docker-compose.override.yml that publishes Postgres to the host (for a DB
# client such as DBeaver). The shared docker-compose.yml deliberately does
# not expose the database, so without that override it has no effect.
HYPERTUBE_DB_PORT=5432
# The edge proxy: https://localhost:8443 serves the app with a self-signed
# certificate (your browser warns once), http://localhost:8080 redirects to
# it. Non-privileged ports so rootless Podman can bind them.
HYPERTUBE_HTTP_PORT=8080
HYPERTUBE_HTTPS_PORT=8443
# Optional - the name the HTTP -> HTTPS redirect sends the browser to (never
# the Host header). Defaults to localhost; set it on a real deployment.
# PROXY_SERVER_NAME=localhost

# Dev only - multiplies every rate limit (register, login, global) so the
# Bruno collection and manual testing don't trip 429s. Keep 1 (the real
# limits) unless you need more; rejected above 1 when NODE_ENV=production.
THROTTLE_LIMIT_MULTIPLIER=1

# Optional - the SPA's origin: the CORS allowed origin, and where the OAuth
# callbacks redirect the browser. Through the edge proxy it is
# https://localhost:<HYPERTUBE_HTTPS_PORT>; for host dev (make dev-frontend)
# unset it and the backend defaults to http://localhost:5173.
FRONTEND_ORIGIN=https://localhost:8443

# The Vite dev server proxies /api to the backend. docker-compose sets
# VITE_API_PROXY_TARGET=http://backend:3000 for the frontend container; host
# dev (make dev-frontend) defaults to http://localhost:3000. To point host dev
# elsewhere, pass it in the shell - `VITE_API_PROXY_TARGET=... make
# dev-frontend` - vite.config.ts reads it from the process env, not this file.

# Secret used to sign auth JWTs. Must be at least 32 characters (the app
# refuses to boot otherwise). Generate a real random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_64_char_secret_before_running_the_app_0000
# Access-token lifetime (vercel/ms format: 15m, 1h, 7d...).
JWT_EXPIRES_IN=15m

# OAuth strategies
# 42 intra
FORTYTWO_CLIENT_ID=replace_with_your_42_oauth_uid
FORTYTWO_CLIENT_SECRET=replace_with_your_42_oauth_secret
FORTYTWO_CALLBACK_URL=https://localhost:8443/api/auth/42/callback
# Github
GITHUB_CLIENT_ID=replace_with_your_github_oauth_id
GITHUB_CLIENT_SECRET=replace_with_your_github_oauth_secret
GITHUB_CALLBACK_URL=https://localhost:8443/api/auth/github/callback

# Dev account the browser-e2e agent logs in with. Not read by the app: it
# only has to exist in your local database (create it with POST /users).
E2E_USER_EMAIL=e2e-user@example.com
E2E_USER_PASSWORD=change_me
