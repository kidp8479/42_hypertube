# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real secrets.

POSTGRES_USER=hypertube
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hypertube

# Optional - CORS allowed origin for the frontend. Defaults to
# http://localhost:5173 if unset. Override in production.
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign auth JWTs. Must be at least 32 characters (the app
# refuses to boot otherwise). Generate a real random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_64_char_secret_before_running_the_app_0000
# Access-token lifetime (vercel/ms format: 15m, 1h, 7d...).
JWT_EXPIRES_IN=15m
