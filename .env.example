# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real secrets.

POSTGRES_USER=hypertube
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hypertube

# Optional - CORS allowed origin for the frontend. Defaults to
# http://localhost:5173 if unset. Override in production.
FRONTEND_ORIGIN=http://localhost:5173

# Optional - where the Vite dev server proxies /api. docker-compose already
# sets this to http://backend:3000 for the container; only set it here if you
# run the frontend outside compose against a non-default backend address.
# Defaults to http://localhost:3000 when unset.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Secret used to sign auth JWTs. Must be at least 32 characters (the app
# refuses to boot otherwise). Generate a real random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_64_char_secret_before_running_the_app_0000
# Access-token lifetime (vercel/ms format: 15m, 1h, 7d...).
JWT_EXPIRES_IN=15m
