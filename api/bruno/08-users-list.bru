meta {
  name: 08 List users (protected)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

docs {
  Each entry is id and username only (subject III.4): no email, no names,
  never the password hash.
}

tests {
  test("each entry is id and username only", function () {
    res.body.forEach((u) => expect(Object.keys(u).sort()).to.eql(["id", "username"]));
  });
}
