meta {
  name: 50 OAuth: the same, form-encoded with grant_type
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/oauth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client: {{apiClient}}
  secret: {{apiSecret}}
}

assert {
  res.status: eq 200
}
