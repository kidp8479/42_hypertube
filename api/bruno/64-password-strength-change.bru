meta {
  name: 64 Password strength: a weak new password on the profile -> 422
  type: http
  seq: 64
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{keyToken}}
}

body:json {
  {
    "password": "motdepasse",
    "currentPassword": "an0ther-p4ss-phrase"
  }
}

docs {
  The current password is right, so the refusal is the new one's strength.
  Nothing is saved: the sessions stay as they were.
}

assert {
  res.status: eq 422
}
