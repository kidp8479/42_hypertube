meta {
  name: 28 Refresh without a cookie -> 204
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/auth/refresh
  body: none
  auth: none
}

docs {
  No cookie means no session to renew: the normal state of a signed-out
  visitor, whose SPA asks on every load. Not an error, so no 401.
}

assert {
  res.status: eq 204
}
