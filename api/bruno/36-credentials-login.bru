meta {
  name: 36 Credentials: log in, the session the change must end
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "sess-{{runId}}",
    "password": "str0ng-p4ss-phrase"
  }
}

script:post-response {
  const fromSetCookie = (res) => {
    const cookie = (res.headers["set-cookie"] || []).find((c) => c.startsWith("refresh_token="));
    return cookie ? cookie.split(";")[0].slice("refresh_token=".length) : undefined;
  };
  bru.setVar("sessToken", res.body.access_token);
  bru.setVar("refreshBeforeChange", fromSetCookie(res));
}

assert {
  res.status: eq 200
}
