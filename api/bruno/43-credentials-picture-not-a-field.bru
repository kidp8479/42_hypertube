meta {
  name: 43 A profile picture that is not https -> 400
  type: http
  seq: 43
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "profilePicture": "http://example.com/avatar.png"
  }
}

docs {
  The URL lands in an <img src>: https only, so no `javascript:` and no mixed
  content.
}

assert {
  res.status: eq 400
}
