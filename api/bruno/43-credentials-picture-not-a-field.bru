meta {
  name: 43 A profile picture sent as a field -> 400
  type: http
  seq: 43
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "profilePicture": "https://example.com/avatar.png"
  }
}

docs {
  The picture is a file the server hosts (HYP-38): it goes to
  PUT /users/:id/picture, never as a linked URL here.
}

assert {
  res.status: eq 400
}
