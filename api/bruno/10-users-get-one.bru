meta {
  name: 10 Get one user (protected)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/{{adaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Ada reads her own profile, so the email is there. Another user's profile
  carries id, username and picture only: covered by
  backend/src/users/users.controller.fields.spec.ts, since the collection has
  no second account alive at this point.
}

assert {
  res.status: eq 200
  res.body.id: eq {{adaId}}
  res.body.email: eq ada-{{runId}}@example.com
}
