meta {
  name: 37 Change the password without currentPassword -> 400
  type: http
  seq: 37
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "password": "an0ther-p4ss-phrase"
  }
}

docs {
  A stolen access token alone must not change the password: the current one
  has to come with it.
}

assert {
  res.status: eq 400
}
