meta {
  name: 18 GitHub OAuth callback without the state cookie -> 302 to the SPA error page
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/auth/github/callback?code=any-code&state=forged
  body: none
  auth: none
}

docs {
  Same login CSRF guard as request 17, on the GitHub strategy.
}

settings {
  followRedirects: false
}

assert {
  res.status: eq 302
  res.headers.location: contains /oauth/callback?error=failed
  res.headers["referrer-policy"]: eq no-referrer
}
