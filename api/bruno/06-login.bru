meta {
  name: 06 Login with the username, any case (public)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "ADA-{{runId}}",
    "password": "str0ng-p4ss-phrase"
  }
}

script:post-response {
  bru.setVar("token", res.body.access_token);
}

assert {
  res.status: eq 200
  res.body.access_token: isString
}

tests {
  test("starts a session: an HttpOnly, SameSite=Strict refresh cookie", function () {
    const cookie = (res.headers["set-cookie"] || []).find((c) => c.startsWith("refresh_token="));
    expect(cookie).to.be.a("string");
    expect(cookie).to.include("HttpOnly");
    expect(cookie).to.include("SameSite=Strict");
  });

  test("keeps the refresh token out of the body", function () {
    expect(JSON.stringify(res.body)).to.not.include("refresh");
  });
}
