meta {
  name: 39 Change the password -> 200 and a new session cookie
  type: http
  seq: 39
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "password": "an0ther-p4ss-phrase",
    "currentPassword": "str0ng-p4ss-phrase"
  }
}

script:post-response {
  const fromSetCookie = (res) => {
    const cookie = (res.headers["set-cookie"] || []).find((c) => c.startsWith("refresh_token="));
    return cookie ? cookie.split(";")[0].slice("refresh_token=".length) : undefined;
  };
  bru.setVar("refreshAfterChange", fromSetCookie(res));
}

docs {
  Every session of the user is revoked, and the caller gets a new one in a
  fresh refresh cookie, so only the caller stays signed in.
}

assert {
  res.status: eq 200
}

tests {
  test("hands the caller a new refresh cookie, scoped to the auth routes", function () {
    expect(bru.getVar("refreshAfterChange")).to.be.a("string");
    const cookie = (res.headers["set-cookie"] || []).find((c) => c.startsWith("refresh_token="));
    expect(cookie).to.match(/Path=\/api\/auth/);
  });
  test("never returns the password", function () {
    expect(res.body).to.not.have.property("password");
    expect(res.body).to.not.have.property("currentPassword");
  });
}
