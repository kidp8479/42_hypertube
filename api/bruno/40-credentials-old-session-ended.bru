meta {
  name: 40 The session from before the change is over -> 401
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/auth/refresh
  body: none
  auth: none
}

headers {
  Cookie: refresh_token={{refreshBeforeChange}}
}

docs {
  Opened with the old password (request 36): the change ended it.
}

assert {
  res.status: eq 401
}
