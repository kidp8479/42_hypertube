meta {
  name: 35 Credentials: register a second user, to clash with
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "email": "other-{{runId}}@example.com",
    "username": "other-{{runId}}",
    "firstName": "Katherine",
    "lastName": "Johnson",
    "password": "str0ng-p4ss-phrase"
  }
}

docs {
  Requests 35 to 44 change the session user's password and email through
  PATCH /users/:id (HYP-84): re-authentication with currentPassword, and the
  other sessions ended by the change (ADR-0011).
}

script:post-response {
  bru.setVar("otherId", res.body.id);
}

assert {
  res.status: eq 201
}
