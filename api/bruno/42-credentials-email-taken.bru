meta {
  name: 42 Change the email to a taken one -> 409
  type: http
  seq: 42
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "email": "other-{{runId}}@example.com",
    "currentPassword": "an0ther-p4ss-phrase"
  }
}

docs {
  The same generic conflict as at registration, and nothing is revoked.
}

assert {
  res.status: eq 409
}
