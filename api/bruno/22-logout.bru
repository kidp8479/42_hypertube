meta {
  name: 22 Logout with an access token only -> 204
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  No refresh cookie is sent here, so nothing is revoked. The access token stays
  valid (it is stateless, only the refresh token is revocable), which is why the
  cleanup request below can still reuse it. The session logout is 33.
}

assert {
  res.status: eq 204
}
