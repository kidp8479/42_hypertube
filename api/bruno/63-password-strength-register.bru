meta {
  name: 63 Password strength: a French word at registration -> 422
  type: http
  seq: 63
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "email": "weak-{{runId}}@example.com",
    "username": "weak-{{runId}}",
    "firstName": "Victor",
    "lastName": "Hugo",
    "password": "anticonstitutionnellement"
  }
}

docs {
  Requests 63 and 64 cover the password strength rule (HYP-37, ADR-0017):
  "any current French word should not be accepted" (marking sheet). 422,
  not 400, so the SPA can say what is wrong without reading the message.
}

assert {
  res.status: eq 422
}
