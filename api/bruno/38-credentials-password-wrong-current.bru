meta {
  name: 38 Change the password with a wrong currentPassword -> 403
  type: http
  seq: 38
}

patch {
  url: {{baseUrl}}/users/{{sessId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessToken}}
}

body:json {
  {
    "password": "an0ther-p4ss-phrase",
    "currentPassword": "not-the-password"
  }
}

assert {
  res.status: eq 403
}
