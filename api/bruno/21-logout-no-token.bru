meta {
  name: 21 Logout with nothing -> 204
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: none
}

docs {
  Logout is public (ADR-0011): it must work after the access token expired, and
  logging out twice is not an error. With no refresh cookie there is nothing to
  revoke, and it still answers 204.
}

assert {
  res.status: eq 204
}
