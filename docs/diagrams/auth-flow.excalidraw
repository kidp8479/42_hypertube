    {
      "id": "5f509e195d9b41219",
      "type": "text",
      "x": 60,
      "y": 1250,
      "width": 553.8,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
