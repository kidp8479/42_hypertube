      "roundness": null,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Why: access tokens are stateless (ADR-0002), no lookup per request. Public route: it must work with an expired access token.",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why: access tokens are stateless (ADR-0002), no lookup per request. Public route: it must work with an expired access token.",
