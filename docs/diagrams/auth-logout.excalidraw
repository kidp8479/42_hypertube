      "fontSize": 18,
      "fontFamily": 1,
      "text": "A copied access token still works until JWT_EXPIRES_IN (15 min by default),\nbut the refresh token is dead: nothing can renew it",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A copied access token still works until JWT_EXPIRES_IN (15 min by default),\nbut the refresh token is dead: nothing can renew it",
