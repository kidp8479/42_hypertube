# Rendered by the nginx image's envsubst step: only ${...} variables that are
# set in the container environment are replaced, nginx's own $variables stay.

server_tokens off;

# The access log keeps the path, never the query string or the Referer: an
# OAuth callback carries the provider's `code` and `state` in its query, and
# the SPA's /oauth/callback page carries our own single-use exchange code,
# which every asset request would repeat in its Referer.
log_format noquery '$remote_addr [$time_local] "$request_method $uri" $status '
                   '$body_bytes_sent "$http_user_agent"';
# `access_log` is set in each server below, not here: at this level it would
# add to the image's default log (full request line, Referer) instead of
# replacing it.

# Plain HTTP only redirects. The target is the configured public name, never
# the Host header (a client could otherwise make us redirect to any site), and
# the HTTPS port published on the host, which may not be 443.
server {
    listen 8080;
    server_name _;
    access_log /dev/stdout noquery;
    return 301 https://${PROXY_SERVER_NAME}:${PROXY_PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;
    access_log /dev/stdout noquery;

    # Upstreams are looked up at request time, not once at start: a recreated
    # backend or frontend container comes back with a new address, and a name
    # resolved at start would keep pointing at the old one (502 until the proxy
    # restarted, HYP-81). The resolver is the container's own DNS, read from
    # /etc/resolv.conf by the image (NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the
    # Dockerfile): 127.0.0.11 on Docker, aardvark-dns on Podman. A variable in
    # proxy_pass is what makes nginx use it.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend http://backend:3000;
    set $frontend http://${PROXY_FRONTEND_UPSTREAM};

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Edge headers. HSTS is keyed on the host name, not the port: sent from
    # https://localhost it would make the browser upgrade every other
    # localhost port (the direct backend and Vite ports) to HTTPS. It is
    # therefore off (max-age=0) unless PROXY_HSTS_MAX_AGE is set for a real
    # deployment. Referrer-Policy is left to the backend, which sets it where
    # it matters (the OAuth callback); an edge value would be a second header.
    add_header Strict-Transport-Security "max-age=${PROXY_HSTS_MAX_AGE}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # API: same contract as the Vite dev proxy, /api/<path> reaches the
    # backend as /<path>. With a variable, proxy_pass no longer swaps the
    # location prefix itself, so the rewrite strips it (the query string is
    # kept).
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        include /etc/nginx/snippets/proxy-headers.conf;
        # The backend never sees /api, so it is told: cookies scoped to the
        # auth routes need the path the browser uses (ADR-0007).
        proxy_set_header X-Forwarded-Prefix /api;
    }

    # Swagger UI and its schema live at the backend root, not under /api.
    location /api-docs {
        proxy_pass $backend;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Everything else is the SPA: Vite in dev, the built files in prod. The
    # upgrade headers carry Vite's HMR websocket in dev.
    location / {
        proxy_pass $frontend;
        proxy_http_version 1.1;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
